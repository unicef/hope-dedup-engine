{
    "type": "object",
    "properties": {
        "detection": {
            "type": "object",
            "properties": {
                "confidence": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1,
                    "default": "constance.config.FACE_DETECTION_CONFIDENCE"
                }
            },
            "default": {},
            "required": [
                "confidence"
            ]
        },
        "recognition": {
            "type": "object",
            "properties": {
                "num_jitters": {
                    "type": "integer",
                    "minimum": 1,
                    "default": "constance.config.FACE_ENCODINGS_NUM_JITTERS"
                },
                "model": {
                    "type": "string",
                    "enum": [
                        "small",
                        "large"
                    ],
                    "default": "constance.config.FACE_ENCODINGS_MODEL"
                },
                "preprocessors": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": []
                    },
                    "uniquItems": true,
                    "default": []
                }
            },
            "default": {},
            "required": [
                "num_jitters",
                "model"
            ]
        },
        "duplicates": {
            "type": "object",
            "properties": {
                "tolerance": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1,
                    "default": "constance.config.FACE_DISTANCE_THRESHOLD"
                }
            },
            "default": {},
            "required": [
                "tolerance"
            ]
        }
    },
    "required": [
        "detection",
        "recognition",
        "duplicates"
    ]
}