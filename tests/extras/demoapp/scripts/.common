#!/usr/bin/env bash

source "$(dirname "0")/.vars"

call_api() {
  http "$1" "${BASE_URL%/}/${2%/}/" Authorization:"Token $AUTH_TOKEN" "${@:3}"
}

set_variable() {
  # Use | as delimiter so values like URLs (with /) do not break sed.
  sed -i "s|$1=.*$|$1=$2|" .vars
}

show_required_args() {
  for var in "$@"
  do
    echo "$var is required"
  done
}
