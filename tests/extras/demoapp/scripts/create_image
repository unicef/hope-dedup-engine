#!/usr/bin/env bash

source "$(dirname "0")/.common"

echo Create image >&2

# We use image name provided as both reference pk and filename

if [[ $# -ne 2 ]] ; then
  show_required_args reference_pk filename
  exit 1
fi

call_api POST "deduplication_sets/$DEDUPLICATION_SET_REFERENCE_PK/images" reference_pk="$1" filename="$2"
