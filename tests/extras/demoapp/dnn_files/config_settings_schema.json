{
    "type": "object",
    "properties": {
        "detection": {
            "type": "object",
            "properties": {
                "confidence": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1.0,
                    "default": "constance.config.FACE_DETECTION_CONFIDENCE"
                }
            },
            "default": {}
        },
        "recognition": {
            "type": "object",
            "properties": {
                "num_jitters": {
                    "type": "integer",
                    "minimum": 1,
                    "default": "constance.config.FACE_ENCODINGS_NUM_JITTERS"
                },
                "model": {
                    "type": "string",
                    "enum": ["small", "large"],
                    "default": "constance.config.FACE_ENCODINGS_MODEL"
                },
                "preprocessors": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": ["contrast"]
                    },
                    "uniqueItems": true,
                    "default": []
                }
            },
            "default": {}
        },
        "duplicates": {
            "type": "object",
            "properties": {
                "tolerance": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1.0,
                    "default": "constance.config.FACE_DISTANCE_THRESHOLD"
                }
            },
            "default": {}
        }
    }
}
